<configuration>

    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss} [%-5level] %-40logger{0} %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Silence noisy LangChain4j / OkHttp internals -->
    <logger name="dev.langchain4j"        level="WARN"/>
    <logger name="okhttp3"                level="WARN"/>
    <logger name="io.netty"               level="WARN"/>

    <!-- Application loggers — INFO and above -->
    <logger name="com.travelagent"        level="INFO"/>

    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
